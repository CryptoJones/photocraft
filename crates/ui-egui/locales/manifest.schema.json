{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhotoCraft localisation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "languages"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 256
    },
    "schemaVersion": {
      "const": 1
    },
    "fallbackLocale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "pattern": "^[a-z]{2,8}(-[a-z0-9]{2,8})*$",
      "default": "en",
      "not": {
        "enum": [
          "auto",
          "posix"
        ]
      }
    },
    "reloadIntervalMs": {
      "type": "integer",
      "minimum": 250,
      "maximum": 60000,
      "default": 1000
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "pluralRule"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16,
            "pattern": "^[a-z]{2,8}(-[a-z0-9]{2,8})*$",
            "not": {
              "enum": [
                "auto",
                "posix"
              ]
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Native display name, without control characters; runtime also caps UTF-8 bytes."
          },
          "catalog": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.tsv$",
                "description": "Flat UTF-8 TSV basename relative to the manifest; no subdirectories or symlinks."
              },
              {
                "type": "null"
              }
            ]
          },
          "pluralRule": {
            "enum": [
              "none",
              "one_other",
              "french",
              "portuguese",
              "russian",
              "czech"
            ],
            "description": "Named integer-count rule, with 1, 2 or 3 catalog forms."
          },
          "fallback": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 2,
                "maxLength": 16,
                "pattern": "^[a-z]{2,8}(-[a-z0-9]{2,8})*$",
                "not": {
                  "enum": [
                    "auto",
                    "posix"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "aliases": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 16,
              "pattern": "^[a-z]{2,8}(-[a-z0-9]{2,8})*$",
              "not": {
                "enum": [
                  "auto",
                  "posix"
                ]
              }
            },
            "default": []
          },
          "completeMenus": {
            "type": "boolean",
            "default": false,
            "description": "Require complete source-key coverage in cargo xtask i18n --check; does not assess linguistic quality."
          }
        }
      }
    }
  }
}
